{
  "name": "file-server",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n vue,node -c blue,green \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:vite": "npm run dev -w frontend",
    "dev:node": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "build:exe": "npm run build && node scripts/build-exe.js"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@yao-pkg/pkg": "^6.22.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "resedit": "^3.1.0"
  }
}
